{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pinDigests": false,
  "ignorePresets": [
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Use container version tags only.",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not create container digest pins or digest refreshes.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
